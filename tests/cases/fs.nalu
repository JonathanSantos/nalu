// fs.* in a temporary folder: write/append/read/size/exists/mkdir/ls/walk/glob/copy/move/replace/rm/temp_file.
let inicio = dirs.cwd()
let t = fs.temp_dir()
let a = t / "a.txt"
fs.write(a, "linha1\n")
fs.append(a, "linha2\n")
print(fs.read(a).lines().join("|"))
print(fs.size(a), fs.modified(a) > 0)
print(fs.exists(a), fs.is_file(a), fs.is_dir(a), fs.is_dir(t))
fs.mkdir(t / "sub" / "dentro")
fs.mkdir(t / "sub")
fs.write(t / "sub" / "dentro" / "z.txt", "z")
fs.write(t / ".oculto", "o")
fs.write(t / "b.log", "b")
print(fs.ls(t).join(","))
print(fs.walk(t).map(p => p.name).join(","))
sys.cd(t)
print(fs.walk("sub").join(","))
print(fs.glob("*.txt").join(","))
print(fs.glob("*").join(","))
print(fs.glob(".*").join(","))
print(fs.glob("sub").join(","))
print(fs.glob("?.log").join(","))
print("[{fs.glob("nada*").join(",")}]")
fs.copy("a.txt", "c.txt")
fs.move("c.txt", "d.txt")
print(fs.exists("c.txt"), fs.read("d.txt").len())
fs.replace("d.txt", "linha", "L")
print(fs.read("d.txt").lines().join(","))
fs.copy("sub", "sub2")
print(fs.read("sub2/dentro/z.txt"))
fs.rm("sub2")
print(fs.exists("sub2"))
fs.rm("nao-existe")
let r = fs.read("nao-existe") catch "padrão"
print(r)
fs.rm(".") catch {
    print("recusou .")
}
fs.rm("") catch {
    print("recusou vazio")
}
let lista = fs.ls("nao-existe") catch ["sem pasta"]
print(lista.join(","))
let tf = fs.temp_file()
print(fs.exists(tf), fs.size(tf))
fs.rm(tf)
sys.cd(inicio)
fs.rm(t)
print(fs.exists(t))
