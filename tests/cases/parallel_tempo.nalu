// parallel runs the tasks at the same time, also in PowerShell (RunspacePool), and `max` limits it.
// Each task returns the window in which it ran ("start end", in ms since t); the results follow the order
// of the list. (`max: 1` comes first: on the linux target, Bash 5's `wait -n` does not wait after an
// earlier `parallel`.)
fn janela(t: int, ms: int) -> str {
    let inicio = time.now_ms() - t
    time.sleep(ms * 1ms)
    return "{inicio} {time.now_ms() - t}"
}

fn ms(janela: str, i: int) -> int {
    return janela.split(" ")[i].to_int() catch -1
}

// max: 1: the second task only starts after the first one ends
let t1 = time.now_ms()
let uma = parallel(max: 1) for _n in [1, 2] {
    janela(t1, 300)
}
print(ms(uma[1], 0) >= ms(uma[0], 1))

// max: 3: three 2s tasks running at the same time (the last starts before the first ends; 2s leaves room
// for slow runspace or process start-up on a busy machine)
let t0 = time.now_ms()
let tres = parallel(max: 3) for _n in [1, 2, 3] {
    janela(t0, 2000)
}
var ultimo_inicio = 0
var primeiro_fim = 1000000
for j in tres {
    ultimo_inicio = math.max(ultimo_inicio, ms(j, 0))
    primeiro_fim = math.min(primeiro_fim, ms(j, 1))
}
print(tres.len(), ultimo_inicio < primeiro_fim)

// the results follow the list order, not the order of completion
let r = parallel(max: 3) for n in [3, 2, 1] {
    time.sleep(n * 200ms)
    n * 10
}
print(r.join(","))
