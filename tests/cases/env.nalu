// env.get/has/set; the value also applies to child commands.
print(env.get("NALU_TESTE_VAR"))
print(env.has("NALU_TESTE_VAR"), env.has("NALU_NAO_EXISTE_123"))
let x = env.get("NALU_NAO_EXISTE_123") catch "faltou"
print(x)
env.set("NALU_NOVA", "nova")
print(env.get("NALU_NOVA"), env.has("NALU_NOVA"))
