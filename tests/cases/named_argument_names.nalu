// `code`, `max` and `every` are ordinary names: named arguments are recognized by their `name:` label.
fn status(code: int) -> str {
    let max = 3
    let every = 1s
    retry(max, every: every) {
        if code < 0 {
            fail "bad", code: 2
        }
    }
    return "code {code}, max {max}"
}

let r = parallel(max: 2) for code in [200, 404] {
    status(code)
}
print(r.join("; "))
let code = 7
$ sh -c "exit 3" catch {
    print(err.code + code)
}
