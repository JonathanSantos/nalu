let b = "it’s “ok” „x‟ ‚y‛"
let c = "‘simples’ e $HOME e `crase` e $(x) e $\{y\} e @(z)"
print(a)
print(b)
print(c)
print(a.len())
$ echo {b}
$ echo "aspas \"duplas\" no argumento" 'e simples'
