{
  "$description": "Nalu brand tokens (W3C Design Tokens). Mirrors tokens.css; generated by build.py.",
  "material": {
    "moana": {
      "$type": "color",
      "$value": "#0b2b3d",
      "$description": "Moana, the open ocean: ink on light, the deep surfaces on dark"
    },
    "abyss": {
      "$type": "color",
      "$value": "#07161f",
      "$description": "Abyss: the dark background and the terminal"
    },
    "foam": {
      "$type": "color",
      "$value": "#e6f3f1",
      "$description": "Foam: ink on dark"
    },
    "salt": {
      "$type": "color",
      "$value": "#f3f8f8",
      "$description": "Salt: light surfaces"
    },
    "reef": {
      "$type": "color",
      "$value": "#0a7480",
      "$description": "Reef: the mark and actions on light"
    },
    "lagoon": {
      "$type": "color",
      "$value": "#36d1c4",
      "$description": "Lagoon: the mark and actions on dark; the signature color"
    },
    "lehua": {
      "$type": "color",
      "$value": "#c42c46",
      "$description": "Lehua blossom: failure and recovery on light"
    },
    "lehua-lt": {
      "$type": "color",
      "$value": "#ff8094",
      "$description": "Lehua blossom: failure and recovery on dark"
    },
    "limu": {
      "$type": "color",
      "$value": "#1d7a4c",
      "$description": "Limu (seaweed): success on light"
    },
    "limu-lt": {
      "$type": "color",
      "$value": "#74d7a0",
      "$description": "Limu (seaweed): success on dark"
    },
    "olena": {
      "$type": "color",
      "$value": "#8f5600",
      "$description": "ʻŌlena (turmeric): warnings on light"
    },
    "olena-lt": {
      "$type": "color",
      "$value": "#f5be5b",
      "$description": "ʻŌlena (turmeric): warnings on dark"
    },
    "sand": {
      "$type": "color",
      "$value": "#f1e9da",
      "$description": "Sand: the shore, where generated scripts land (illustrations only)"
    }
  },
  "color": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "surface": {
        "$type": "color",
        "$value": "{material.salt}"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#e9f2f2"
      },
      "code-bg": {
        "$type": "color",
        "$value": "#eef5f5"
      },
      "ink": {
        "$type": "color",
        "$value": "{material.moana}"
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#4a6573"
      },
      "rule": {
        "$type": "color",
        "$value": "#d6e4e6"
      },
      "action": {
        "$type": "color",
        "$value": "{material.reef}",
        "$description": "what you write and what you do: keywords, links, actions, {x}, $"
      },
      "fail": {
        "$type": "color",
        "$value": "{material.lehua}",
        "$description": "failure and recovery: catch, fail, ignore, try, errors"
      },
      "ok": {
        "$type": "color",
        "$value": "{material.limu}",
        "$description": "it worked: passing tests, strings in code"
      },
      "warn": {
        "$type": "color",
        "$value": "{material.olena}",
        "$description": "warnings"
      },
      "mark": {
        "$type": "color",
        "$value": "{material.reef}",
        "$description": "the mark (always one color)"
      },
      "shore": {
        "$type": "color",
        "$value": "{material.sand}",
        "$description": "where generated scripts land, in diagrams"
      },
      "shore-ink": {
        "$type": "color",
        "$value": "#5c4a2a"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "{material.abyss}"
      },
      "surface": {
        "$type": "color",
        "$value": "#0c202b"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#11293a"
      },
      "code-bg": {
        "$type": "color",
        "$value": "#0a1c26"
      },
      "ink": {
        "$type": "color",
        "$value": "{material.foam}"
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#93acb4"
      },
      "rule": {
        "$type": "color",
        "$value": "#1d3746"
      },
      "action": {
        "$type": "color",
        "$value": "{material.lagoon}",
        "$description": "what you write and what you do: keywords, links, actions, {x}, $"
      },
      "fail": {
        "$type": "color",
        "$value": "{material.lehua-lt}",
        "$description": "failure and recovery: catch, fail, ignore, try, errors"
      },
      "ok": {
        "$type": "color",
        "$value": "{material.limu-lt}",
        "$description": "it worked: passing tests, strings in code"
      },
      "warn": {
        "$type": "color",
        "$value": "{material.olena-lt}",
        "$description": "warnings"
      },
      "mark": {
        "$type": "color",
        "$value": "{material.lagoon}",
        "$description": "the mark (always one color)"
      },
      "shore": {
        "$type": "color",
        "$value": "#1f2a26",
        "$description": "where generated scripts land, in diagrams"
      },
      "shore-ink": {
        "$type": "color",
        "$value": "#e3d3b3"
      }
    }
  },
  "syntax": {
    "keyword": {
      "$type": "color",
      "$value": "{color.light.action}",
      "$description": "let var fn return struct enum param if else for in while match break continue defer parallel retry native test self true false (normal)",
      "$extensions": {
        "nalu.dark": "{color.dark.action}",
        "nalu.fontStyle": "normal"
      }
    },
    "fail": {
      "$type": "color",
      "$value": "{color.light.fail}",
      "$description": "catch fail ignore try (bold)",
      "$extensions": {
        "nalu.dark": "{color.dark.fail}",
        "nalu.fontStyle": "bold"
      }
    },
    "string": {
      "$type": "color",
      "$value": "{color.light.ok}",
      "$description": "\"…\" and '…' (normal)",
      "$extensions": {
        "nalu.dark": "{color.dark.ok}",
        "nalu.fontStyle": "normal"
      }
    },
    "interp": {
      "$type": "color",
      "$value": "{color.light.action}",
      "$description": "the braces of {x}, in strings and commands (normal)",
      "$extensions": {
        "nalu.dark": "{color.dark.action}",
        "nalu.fontStyle": "normal"
      }
    },
    "command": {
      "$type": "color",
      "$value": "{color.light.action}",
      "$description": "the $ of $ cmd and $( ) (bold)",
      "$extensions": {
        "nalu.dark": "{color.dark.action}",
        "nalu.fontStyle": "bold"
      }
    },
    "program": {
      "$type": "color",
      "$value": "{color.light.ink}",
      "$description": "the program name after $ (bold)",
      "$extensions": {
        "nalu.dark": "{color.dark.ink}",
        "nalu.fontStyle": "bold"
      }
    },
    "comment": {
      "$type": "color",
      "$value": "{color.light.ink-soft}",
      "$description": "// and /// (italic)",
      "$extensions": {
        "nalu.dark": "{color.dark.ink-soft}",
        "nalu.fontStyle": "italic"
      }
    },
    "type": {
      "$type": "color",
      "$value": "{color.light.ink-soft}",
      "$description": "str int bool path duration secret and capitalized names (normal)",
      "$extensions": {
        "nalu.dark": "{color.dark.ink-soft}",
        "nalu.fontStyle": "normal"
      }
    },
    "plain": {
      "$type": "color",
      "$value": "{color.light.ink}",
      "$description": "the rest: names, numbers, operators (normal)",
      "$extensions": {
        "nalu.dark": "{color.dark.ink}",
        "nalu.fontStyle": "normal"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Recursive",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "headlines and big numbers; never paragraphs or code",
      "$extensions": {
        "nalu.axes": "'MONO' 0, 'CASL' 0.6",
        "nalu.weight": 800
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Recursive",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "prose and interface",
      "$extensions": {
        "nalu.axes": "'MONO' 0, 'CASL' 0",
        "nalu.weight": 400
      }
    },
    "label": {
      "$type": "fontFamily",
      "$value": [
        "Recursive",
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ],
      "$description": "eyebrows, tags and table heads: uppercase, tracked",
      "$extensions": {
        "nalu.axes": "'MONO' 1, 'CASL' 0",
        "nalu.weight": 600
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Recursive",
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ],
      "$description": "code, terminal, values; no ligatures",
      "$extensions": {
        "nalu.axes": "'MONO' 1, 'CASL' 0",
        "nalu.weight": 400
      }
    }
  },
  "size": {
    "xs": {
      "$type": "dimension",
      "$value": "12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "19px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "23px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "28px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "36px"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "48px"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "68px"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "72px"
    },
    "9": {
      "$type": "dimension",
      "$value": "112px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "terminal": {
    "$description": "Compiler and generated-script output: 16-color ANSI code and the truecolor equivalent. Respect NO_COLOR and turn color off outside a terminal; color never carries meaning alone.",
    "bg": {
      "$type": "color",
      "$value": "#04111a",
      "$extensions": {
        "nalu.ansi": null
      },
      "$description": "terminal block background"
    },
    "fg": {
      "$type": "color",
      "$value": "#d9ebe8",
      "$extensions": {
        "nalu.ansi": "0"
      },
      "$description": "regular text"
    },
    "dim": {
      "$type": "color",
      "$value": "#7f98a1",
      "$extensions": {
        "nalu.ansi": "2"
      },
      "$description": "the | gutter, line numbers, '+ cmd' from --verbose, '-->'"
    },
    "bold": {
      "$type": "color",
      "$value": "#f2faf8",
      "$extensions": {
        "nalu.ansi": "1"
      },
      "$description": "error location, generated file names"
    },
    "error": {
      "$type": "color",
      "$value": "#ff8094",
      "$extensions": {
        "nalu.ansi": "1;31"
      },
      "$description": "'error[E…]:', 'error:', the ^^^ underline, 'FAILED'"
    },
    "warn": {
      "$type": "color",
      "$value": "#f5be5b",
      "$extensions": {
        "nalu.ansi": "33"
      },
      "$description": "'warning[W…]:', 'warning:'"
    },
    "help": {
      "$type": "color",
      "$value": "#36d1c4",
      "$extensions": {
        "nalu.ansi": "36"
      },
      "$description": "'= help:', '[dry-run]', 'info:'"
    },
    "ok": {
      "$type": "color",
      "$value": "#74d7a0",
      "$extensions": {
        "nalu.ansi": "32"
      },
      "$description": "'ok' (tests and build)"
    }
  }
}
